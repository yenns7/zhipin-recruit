# Java + Vue rebuild 小范围真实用户试点环境变量样例
# 复制到服务器安全位置，例如 /etc/hireinsight/hireinsight-pilot.env。
# 不要把真实 .env、真实密钥、真实数据库密码提交到 git。

SPRING_PROFILES_ACTIVE=pilot

# Java 后端
SERVER_PORT=8080
JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars
JWT_EXPIRY_HOURS=8
PUBLIC_REGISTRATION_ENABLED=false
CORS_ALLOWED_ORIGINS=https://hr-pilot.example.com

# PostgreSQL
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/hireinsight
DATABASE_USER=hireinsight_app
DATABASE_PASSWORD=replace-with-strong-db-password

# 上传与日志
UPLOAD_FOLDER=/srv/hireinsight/uploads
BACKUP_DIR=/srv/hireinsight/backups
LOGGING_FILE_NAME=/var/log/hireinsight/backend.log

# 字段加密（AES-GCM 256-bit）
# 生成：openssl rand -hex 32
FIELD_ENCRYPTION_KEY=replace-with-32-byte-hex-key-0123456789abcdef

# 安全头（默认启用）
SECURITY_HEADERS_ENABLED=true

# 首次试点初始化管理员：只在账号不存在时创建；首次登录后删除这两个变量并由管理员重置密码。
PILOT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PILOT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-one-time-strong-admin-password
